DATABASE_URL=
SECRET_KEY=
ADMIN_PASSWORD=

GROQ_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SENDGRID_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated list of email addresses/phone numbers allowed to receive
# outbound email/SMS while the lockdown is active. Leave unset to block all
# outbound sends (fail closed).
ALLOWLIST_EMAILS=
ALLOWLIST_PHONES=

# ── B2B lead-generation pipeline (backend/routers/leads.py) ──────────────────

# Apollo.io API key for company search/enrichment. Leave unset to use realistic
# mock/demo company data instead (no paid Apollo account required for local dev).
APOLLO_API_KEY=

# Shared secret required on the POST /leads/webhook inbound intake endpoint
# (X-Webhook-Secret header) — machine-to-machine auth for n8n/external forms,
# separate from ADMIN_PASSWORD. Leave unset to block all webhook intake (fail closed).
LEADS_WEBHOOK_SECRET=

# HMAC secret used to sign lead-outreach unsubscribe tokens. Optional — falls back
# to ADMIN_PASSWORD if unset, but a dedicated secret is recommended.
LEADS_UNSUBSCRIBE_SECRET=

# Public base URL of this backend API, used to build the unsubscribe link embedded
# in lead outreach emails (e.g. https://your-backend.up.railway.app).
API_BASE_URL=
